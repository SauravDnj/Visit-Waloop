# Copy to .env.local and fill in. Without these, booking runs in preview mode (no real invites).

# Google Cloud OAuth client (type: Desktop app) with the Google Calendar API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Run `npm run google:token` once to get this
GOOGLE_REFRESH_TOKEN=

# Calendar that holds demos. "primary" = the signed-in account's main calendar.
GOOGLE_CALENDAR_ID=primary

# Optional: teammates added to every demo invite (comma-separated)
DEMO_TEAM_EMAILS=

# Optional: the connected account's address, so reminder emails show "WALOOP" as the sender name
GOOGLE_SENDER_EMAIL=

# Secret the cron job must send to /api/reminders (any long random string)
CRON_SECRET=
